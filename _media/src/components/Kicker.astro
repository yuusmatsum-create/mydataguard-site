---
import { CATEGORIES } from '../lib/validate.js';
import { url, fmtDate } from '../lib/articles.js';
import Icon from './Icon.astro';
const { data } = Astro.props;
---
<p class="kicker">
  <a class={`cat c-${data.category}`} href={url(`category/${data.category}/`)}><Icon name={data.category} size={16} />{CATEGORIES[data.category]}</a>
  <time datetime={data.publishedAt.toISOString().slice(0, 10)}>{fmtDate(data.publishedAt)}</time>
  {data.draft && <span class="draft">下書き</span>}
</p>
