---
import '../styles/news.css';
import { url } from '../lib/articles.js';

interface Props { title: string; description: string; current?: string; ogType?: string; jsonLd?: object }
const { title, description, current, ogType = 'website', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['incident', '漏えい事案'],
  ['vulnerability', '脆弱性'],
  ['threat', '脅威動向'],
  ['digest', '朝刊'],
];
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; form-action 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="strict-origin-when-cross-origin">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" type="application/rss+xml" title="MyDataGuard ニュース" href={url('rss.xml')}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="MyDataGuard ニュース">
<link rel="stylesheet" href="/style.css">
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body class="news">
<a class="skip" href="#main">本文へ移動</a>

<header class="bar">
  <div class="wrap">
    <a class="brand" href="/" aria-label="MyDataGuard トップ"><svg viewBox="0 0 20 20" aria-hidden="true"><rect width="20" height="20" rx="4" fill="#13223A"/><path d="M5 7.5h10M5 10h10M5 12.5h6" stroke="#fff" stroke-width="1.2"/></svg>MyDataGuard</a>
    <nav class="nav" aria-label="サイト内">
      <a href={url('/')} aria-current={current === 'home' ? 'page' : undefined}>ニュース</a>
      <a href="/">サービス</a>
    </nav>
  </div>
</header>

<nav class="cats" aria-label="カテゴリ">
  <div class="wrap">
    <a href={url('/')} aria-current={current === 'home' ? 'page' : undefined}>すべて</a>
    {nav.map(([k, label]) => <a href={url(`category/${k}/`)} aria-current={current === k ? 'page' : undefined}>{label}</a>)}
  </div>
</nav>

<main id="main">
  <slot />
</main>

<footer class="foot">
  <div class="wrap">
    <div class="who">
      <b>MyDataGuard ニュース</b>
      <p>運営：<span class="operator-trade-name">松本悠作</span><br>記事の下書きにAIを使い、公開前に編集者が全件を確認しています。</p>
    </div>
    <ul>
      <li><a href={url('about/')}>編集方針・訂正について</a></li>
      <li><a href={url('rss.xml')}>RSS</a></li>
      <li><a href="/privacy.html">プライバシーポリシー</a></li>
      <li><a href="/">MyDataGuard について</a></li>
    </ul>
  </div>
</footer>
</body>
</html>
