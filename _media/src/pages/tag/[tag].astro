---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getArticles } from '../../lib/articles.js';

export async function getStaticPaths() {
  const all = await getArticles();
  const tags = [...new Set(all.flatMap((e) => e.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { items: all.filter((e) => e.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { items } = Astro.props;
---
<Base title={`「${tag}」の記事｜MyDataGuard ニュース`} description={`「${tag}」に関する記事の一覧です。`}>
  <section class="masthead"><div class="wrap"><p class="eyebrow">タグ</p><h1>{tag}</h1></div></section>
  <div class="wrap"><ArticleList items={items} /></div>
</Base>
