---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Kicker from '../components/Kicker.astro';
import ArticleList from '../components/ArticleList.astro';
import Icon from '../components/Icon.astro';
import { getArticles, url, fmtDate } from '../lib/articles.js';
import { CAUSES, CATEGORIES } from '../lib/validate.js';
import { displayTitle, splitInsight, PRIO } from '../lib/display.js';
import { tagSlug } from '../lib/tags.js';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// 原因の分類は見出し直下の「状況の帯」で見せるので、概要表には重ねない
const facts = [...d.facts];
const ins = splitInsight(d.insight);
const all = await getArticles();
const related = [
  ...all.filter((e) => e.id !== entry.id && e.data.category === d.category),
  ...all.filter((e) => e.id !== entry.id && e.data.category !== d.category && e.data.category !== 'digest'),
].slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.title,
  description: d.summary,
  datePublished: d.publishedAt.toISOString(),
  dateModified: (d.updatedAt ?? d.publishedAt).toISOString(),
  inLanguage: 'ja',
  publisher: { '@type': 'Organization', name: 'MyDataGuard' },
};
---
<Base title={`${d.title}｜MyDataGuard ニュース`} description={d.summary} current={d.category} ogType="article" jsonLd={jsonLd}>
  <article class="wrap">
    <div class="article">
      <header class="a-head">
        <Kicker data={d} />
        <h1>{displayTitle(d.title)}</h1>
        <p class="n-sum">{d.summary}</p>
      </header>

      {d.priority && (
        <div class={`status s-${d.priority}`}>
          <p class="st-k">対応の優先度</p>
          <ol class="scale" aria-label={`対応の優先度：${PRIO[d.priority].label}（3段階）`}>
            {['now', 'week', 'planned'].map((k) => (
              <li class={k === d.priority ? 'on' : ''} aria-current={k === d.priority ? 'step' : undefined}>{PRIO[k].short}</li>
            ))}
          </ol>
        </div>
      )}
      {d.cause && (
        <div class="status s-cause">
          <p class="st-k">原因の分類</p>
          <p class="st-v"><Icon name="cause" size={18} />{CAUSES[d.cause]}</p>
        </div>
      )}

      {d.insight && (
        <section class="insight big" aria-labelledby="ins-h">
          <h2 class="k" id="ins-h">MyDataGuard の視点</h2>
          <p class="ins-head">{ins.head}</p>
          {ins.rest && <p class="ins-rest">{ins.rest}</p>}
        </section>
      )}

      {facts.length > 0 && (
        <section class="facts-box" aria-labelledby="facts-h">
          <h2 id="facts-h">概要</h2>
          <dl class="facts">
            {facts.map((f) => (<div><dt>{f.label}</dt><dd>{f.value}</dd></div>))}
          </dl>
        </section>
      )}

      <div class="prose"><Content /></div>

      {d.actions.length > 0 && (
        <section class="actions" aria-labelledby="actions-h">
          <h2 id="actions-h"><Icon name="check" size={20} />自社でやるべきこと</h2>
          <ol>{d.actions.map((a) => <li>{a}</li>)}</ol>
        </section>
      )}

      {d.category === 'incident' && (
        <aside class="bridge">
          <div>
            <b>あなたの情報は、どの会社にありますか。</b>
            <p>MyDataGuard は、届いたメールの件名と差出人だけから、あなたの個人情報を持つ会社の一覧を作ります。本文は読まず、ブラウザの外に送りません。</p>
          </div>
          <a href="/">MyDataGuard を見る</a>
        </aside>
      )}

      <section class="meta-block" aria-labelledby="src-h">
        <h2 id="src-h">出典</h2>
        <ol>
          {d.sources.map((s) => (
            <li><a href={s.url} rel="noopener">{s.title}</a>{s.date && `（${s.date}）`}</li>
          ))}
        </ol>
      </section>

      {d.corrections.length > 0 && (
        <section class="meta-block" aria-labelledby="fix-h">
          <h2 id="fix-h">訂正・更新の履歴</h2>
          <ol>{d.corrections.map((c) => <li>{c.date}　{c.note}</li>)}</ol>
        </section>
      )}

      {d.tags.length > 0 && (
        <p class="tags">{d.tags.map((t) => <a href={url(`tag/${tagSlug(t)}/`)}>#{t}</a>)}</p>
      )}

      <p class="disclose">
        この記事は、公式発表と公的機関の公表情報をもとに作成しています。下書きにAIを使い、公開前に編集者が内容を確認しました。
        {d.updatedAt && <>最終更新：{fmtDate(d.updatedAt)}。</>}
        誤りのご指摘は<a href={url('about/')}>編集方針・訂正について</a>をご覧ください。
      </p>
    </div>
  </article>

  {related.length > 0 && (
    <section class="wrap related" aria-labelledby="rel-h">
      <div class="sec-head"><h2 id="rel-h">次に読む</h2><a href={url(`category/${d.category}/`)}>{CATEGORIES[d.category]}の記事をすべて見る</a></div>
      <ArticleList items={related} />
    </section>
  )}
</Base>
